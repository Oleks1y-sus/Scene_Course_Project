# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
TRUST_PROXY=1

# ── Database ───────────────────────────────────────────────────────────────
# Production: PostgreSQL connection string from Supabase (session pooler, port 5432)
# Example: postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=pglite
DATABASE_SSL=false
DB_POOL_MAX=10
# Local demo database (used only when DATABASE_URL=pglite)
PGLITE_DATA_DIR=./.data/pglite

# ── Web origin / CORS / cookies ───────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_EXTRA_ORIGINS=
SESSION_TTL_DAYS=7
SESSION_COOKIE_NAME=scene_session
COOKIE_SECURE=false

# ── Secrets (generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))") ──
SESSION_PEPPER=dev-only-session-pepper-change-me-please-123456789
OTP_PEPPER=dev-only-otp-pepper-change-me-please-123456789
IP_PEPPER=dev-only-ip-pepper-change-me-please-123456789

# ── Email (Resend) ─────────────────────────────────────────────────────────
# In development the console transport prints emails to the API log.
MAIL_MODE=console
RESEND_API_KEY=
RESEND_FROM="Сцена <no-reply@scene.example>"
EXPOSE_DEV_CODES=true
SUPPORT_EMAIL=support@scene.example

# ── Uploads (Supabase Storage recommended in production) ──────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=scene-media
UPLOAD_DIR=./uploads

# ── Request hardening ─────────────────────────────────────────────────────
RATE_LIMIT_DISABLED=false
ALLOW_ORIGINLESS_REQUESTS=false
MAX_ACTIVE_SESSIONS=10

# ── Seed accounts ──────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@scene.local
ADMIN_PASSWORD=Admin12345!
ADMIN_NAME=Адміністратор
SEED_DEMO=true
DEMO_PASSWORD=Demo12345!
